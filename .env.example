# Telegram token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Safety: comma-separated chat IDs where bot is allowed to work.
# Empty means all chats are allowed. Recommended: set this after /start or /stats shows chat_id.
ALLOWED_CHAT_IDS=

# Comma-separated chats where the selected feature is disabled. Empty means enabled everywhere.
# Use the same IDs in both values to disable joke awards and casino in a chat.
JOKE_AWARDS_DISABLED_CHAT_IDS=
CASINO_DISABLED_CHAT_IDS=

# LLM provider: auto, openai, ollama.
# auto uses OpenAI when OPENAI_API_KEY is present, otherwise Ollama.
LLM_PROVIDER=auto

# OpenAI API key. ChatGPT subscription is not enough; API key is billed separately.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint, for example LM Studio, LiteLLM, vLLM, or OpenRouter.
# When this is set, OPENAI_API_KEY may be a dummy value if the local server does not require auth.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Local fallback via Ollama: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=1800
OLLAMA_KEEP_ALIVE=30m
OLLAMA_UNLOAD_AFTER_TASK=true
#OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=800

# Optional separate model for /question. Empty means use OLLAMA_MODEL.
QUESTION_MODEL=

# Optional small model for addressed-message intent routing. Empty uses QUESTION_MODEL, then OLLAMA_MODEL.
INTENT_ROUTER_MODEL=

# Models used by /compare, comma-separated. Keep empty for a first local run.
# Stronger local machines, including 48 GB Macs, can try: qwen3:14b,gemma3:27b,qwen3-coder:30b
COMPARE_MODELS=

# Free Wikipedia search for /wiki. No API key is required.
WIKI_SEARCH_ENABLED=true
WIKI_LANGUAGE=ru
WIKI_TIMEOUT_SECONDS=20
WIKI_MAX_RESULTS=3
WIKI_USER_AGENT=telegram-summary-bot/0.1 (https://github.com/Arkadiy915ggo/relay-assistant-bot)

# SQLite database path.
DATABASE_PATH=data/messages.sqlite3
LOG_FILE=data/bot.log
RESPONSE_LOG_FILE=data/responses.log

# Optional early media download limit for Telegram Bot API, in MB.
# 0 means: do not guess the Telegram limit; try downloading and handle Telegram's actual answer.
TELEGRAM_DOWNLOAD_LIMIT_MB=0

# Optional Opik tracing: https://www.comet.com/opik
# When OPIK_ENABLED=true, LLM prompts and outputs are sent to the configured Opik backend
# if OPIK_CAPTURE_CONTENT=true. Use a local/self-hosted Opik instance for private chats.
OPIK_ENABLED=false
OPIK_PROJECT_NAME=telegram-summary-bot
OPIK_CAPTURE_CONTENT=true
# Configure Opik via `opik configure` or env vars such as:
# OPIK_API_KEY=
# OPIK_WORKSPACE=
# OPIK_URL_OVERRIDE=http://localhost:5173/api/

# Local voice/audio transcription via faster-whisper.
TRANSCRIBE_VOICE=false
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Empty means Whisper auto-detects speech language. Use ru/pl/en to force one language.
WHISPER_LANGUAGE=
MAX_VOICE_SECONDS=600
VOICE_DOWNLOAD_DIR=data/voice
TRANSCRIPTION_FORMAT_ENABLED=true
TRANSCRIPTION_FORMAT_PROVIDER=ollama
TRANSCRIPTION_FORMAT_MODEL=qwen2.5vl:7b
#TRANSCRIPTION_FORMAT_NUM_CTX=32768
TRANSCRIPTION_FORMAT_NUM_PREDICT=4096
MAX_TRANSCRIPTION_FORMAT_CHARS=12000

# Manual image recognition through an Ollama vision model.
# The bot only records incoming image file IDs. OCR runs only when /image or /ocr is used.
IMAGE_RECOGNITION_MODEL=qwen2.5vl:7b
#IMAGE_RECOGNITION_NUM_CTX=32768
MAX_IMAGE_SIZE_MB=20
IMAGE_DOWNLOAD_DIR=data/images

# Meme generation from a replied/latest image. Empty MEME_MODEL uses IMAGE_RECOGNITION_MODEL.
MEME_ENABLED=true
MEME_MODEL=
MEME_OUTPUT_DIR=data/memes
MEME_FONT_PATH=
MEME_MAX_IMAGE_SIZE_MB=20
MEME_NUM_PREDICT=160

# Manual video recognition through key frames and an Ollama vision model.
# The bot only records incoming video file IDs. Recognition runs only when /video or /vocr is used.
VIDEO_RECOGNITION_MODEL=qwen2.5vl:7b
#VIDEO_RECOGNITION_NUM_CTX=32768
VIDEO_RECOGNITION_NUM_PREDICT=800
MAX_VIDEO_SIZE_MB=50
MAX_VIDEO_SECONDS=120
VIDEO_DOWNLOAD_DIR=data/video
VIDEO_FRAME_DIR=data/video_frames
VIDEO_FRAME_COUNT=8
VIDEO_FRAME_MAX_WIDTH=960
VIDEO_TRANSCRIBE_AUDIO=false

# Limits to keep summaries fast and predictable.
MAX_MESSAGE_CHARS=4000
MAX_TRANSCRIPTION_CHARS=50000
MAX_SUMMARY_INPUT_CHARS=50000
CHUNK_CHARS=7000

# Default period for /summary without arguments.
DEFAULT_SUMMARY_PERIOD=24h

# Autonomous joke awards. Disabled by default; start production rollout in shadow mode.
AUTONOMOUS_JOKES_ENABLED=false
AUTONOMOUS_JOKES_SHADOW_MODE=true
AUTONOMOUS_JOKES_BLOCK_MESSAGES=20
AUTONOMOUS_JOKES_PARTIAL_MIN_MESSAGES=5
AUTONOMOUS_JOKES_MAX_BLOCK_AGE=24h
# On first autonomous-worker start, only messages received afterwards are eligible.
# This lookback only limits recovery after that saved activation point.
AUTONOMOUS_JOKES_INITIAL_LOOKBACK=7d
AUTONOMOUS_JOKES_STARTUP_GRACE_SECONDS=60
AUTONOMOUS_JOKES_POLL_SECONDS=30
AUTONOMOUS_JOKES_LEASE_SECONDS=900
AUTONOMOUS_JOKE_JUDGE_MODEL=
AUTONOMOUS_JOKE_ANNOUNCE=true
BOT_AUTO_CASINO_ENABLED=true
BOT_AUTO_CASINO_CHANCE=0.25

# Structured chat memory for long /question and /summary periods.
# Participant profile facts are also extracted from recent raw messages after
# /summary and /question. The profile extraction chunk size is derived from
# OLLAMA_NUM_CTX and capped by CHUNK_CHARS/MEMORY_CHUNK_CHARS.
# MEMORY_MAX_BLOCKS is per hierarchy level; older blocks are rolled up.
MEMORY_ENABLED=true
MEMORY_RECENT_PERIOD=24h
MEMORY_CHUNK_CHARS=18000
MEMORY_MAX_BLOCKS=200
MEMORY_SEARCH_LIMIT=8
